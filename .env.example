# Copy this file to .env and adjust the values. Never commit .env.
# All variables are optional; the defaults are shown.

# Address and port the service listens on when started with `python -m app`.
# Use 0.0.0.0 inside a container.
HOST=127.0.0.1
PORT=8000

# One of: critical, error, warning, info, debug
LOG_LEVEL=info
