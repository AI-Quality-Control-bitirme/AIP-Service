# Copy this file to .env and adjust the values. Never commit .env.
# All variables are optional; the defaults are shown.

# Address and port the service listens on when started with `python -m app`.
# Use 0.0.0.0 inside a container.
HOST=127.0.0.1
PORT=8000

# One of: critical, error, warning, info, debug
LOG_LEVEL=info

# LLM client (app/llm)
# One of: fake, gemini. "fake" needs no key and never calls a paid API.
LLM_PROVIDER=fake
# Secret: required when LLM_PROVIDER=gemini. Put the real key only in .env, never commit it.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Seconds to wait for one LLM response before it counts as a timeout.
LLM_TIMEOUT_S=30
# Retries for temporary failures (timeouts, 429, 5xx), 0-3.
LLM_MAX_RETRIES=3
